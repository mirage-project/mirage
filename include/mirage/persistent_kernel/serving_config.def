// Single source for the Python/CUDA int64 serving payload. Entries are ordered;
// expressions may reference earlier entries. Rebuild kernels after changes.
SERVING_CONSTANT(MAX_BIASES, 256)
SERVING_CONSTANT(MAX_EOS, 16)
SERVING_CONSTANT(MAX_STOPS, 4)
SERVING_CONSTANT(MAX_STOP_TOKENS, 32)
SERVING_CONSTANT(MAX_NEW_TOKENS, 0)
SERVING_CONSTANT(SEED, MAX_NEW_TOKENS + 1)
SERVING_CONSTANT(VOCAB_SIZE, SEED + 1)
SERVING_CONSTANT(TEMPERATURE, VOCAB_SIZE + 1)
SERVING_CONSTANT(TOP_P, TEMPERATURE + 1)
SERVING_CONSTANT(TOP_K, TOP_P + 1)
SERVING_CONSTANT(FREQUENCY_PENALTY, TOP_K + 1)
SERVING_CONSTANT(PRESENCE_PENALTY, FREQUENCY_PENALTY + 1)
SERVING_CONSTANT(REPETITION_PENALTY, PRESENCE_PENALTY + 1)
SERVING_CONSTANT(EOS_COUNT, REPETITION_PENALTY + 1)
SERVING_CONSTANT(BIAS_COUNT, EOS_COUNT + 1)
SERVING_CONSTANT(CACHE_HISTORY, BIAS_COUNT + 1)
SERVING_CONSTANT(STOP_COUNT, CACHE_HISTORY + 1)
SERVING_CONSTANT(EOS_IDS, STOP_COUNT + 1)
SERVING_CONSTANT(BIAS_STRIDE, 2)
SERVING_CONSTANT(BIASES, EOS_IDS + MAX_EOS)
SERVING_CONSTANT(STOP_STRIDE, MAX_STOP_TOKENS + 1)
SERVING_CONSTANT(STOP_SEQUENCES, BIASES + BIAS_STRIDE * MAX_BIASES)
SERVING_CONSTANT(CONFIG_WORDS, STOP_SEQUENCES + STOP_STRIDE * MAX_STOPS)
SERVING_CONSTANT(FINISH_NONE, 0)
SERVING_CONSTANT(FINISH_STOP, 1)
SERVING_CONSTANT(FINISH_LENGTH, 2)
SERVING_CONSTANT(FINISH_CANCELLED, 3)
// Sampler scratch: scores, candidate token IDs, total counts, generated counts.
SERVING_CONSTANT(SCRATCH_VOCAB_ARRAYS, 4)
SERVING_CONSTANT(MAX_SAMPLING_THREADS, 256)
SERVING_CONSTANT(WARP_SIZE, 32)
SERVING_CONSTANT(RADIX_BITS, 4)
SERVING_CONSTANT(RADIX_BINS, 16)
SERVING_CONSTANT(SCRATCH_WORKSPACE, 2 * RADIX_BINS * MAX_SAMPLING_THREADS / WARP_SIZE)
SERVING_CONSTANT(SCRATCH_STATE_WORDS, 2)
// Reuse the persistent worker's dynamic shared memory for the probe sort.
SERVING_CONSTANT(SAMPLING_SHARED_BYTES, 16 * 1024)
